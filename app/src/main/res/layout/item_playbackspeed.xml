<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="clickListener"
            type="android.view.View.OnClickListener" />

        <variable
            name="modelPlayBackSpeed"
            type="com.video.avd.ui.playbackspeed.ModelPlayBackSpeed" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">

        <TextView
            android:id="@+id/buttonSpeed"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_playback_button"
            android:fontFamily="@font/urbanist_medium"
            android:gravity="center"
            android:onClickListener="@{clickListener}"
            android:text="@{modelPlayBackSpeed.speedText}"
            android:textColor="@color/brand_text_primary" />
    </RelativeLayout>
</layout>