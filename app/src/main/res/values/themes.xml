<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BaseProject_2023" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_accent</item>
        <item name="colorPrimaryDark">@color/brand_gradient_start</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="autoCompleteTextViewStyle">@style/SearchAutoCompleteTextView</item>
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogThemes</item>
        <!-- Add the following item to specify the popup menu style -->
        <item name="popupMenuStyle">@style/PopupMenuStyle.Dark</item>
        <!-- Customize your theme here. -->
        <item name="android:searchIcon">@null</item>
        <item name="castExpandedControllerStyle">@style/CustomCastExpandedController</item>
    </style>
<!--    Media Chooser Activity Theme-->
    <style name="MediaChooserDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <!-- Custom App Themes -->
    <style name="Theme.DynamicThemeSetting" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Primary brand color. -->

        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="colorPrimary">@color/brand_background</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <!-- Secondary brand color. -->
        <item name="colorOnSecondary">@color/brand_text_primary</item>
        <item name="autoCompleteTextViewStyle">@style/SearchAutoCompleteTextView</item>
        <!-- Status bar color. -->
<!--        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>-->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogThemes</item>
        <item name="popupMenuStyle">@style/PopupMenuStyle</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
        <!-- Customize your theme here. -->
        <item name="android:searchIcon">@null</item>
        <item name="castExpandedControllerStyle">@style/CustomCastExpandedController</item>
    </style>



    <style name="WindowAnimationTransition">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="PopupMenuStyle" parent="Widget.AppCompat.PopupMenu">
        <!-- Add this item to enable icons in the popup menu -->
        <item name="android:popupBackground">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="actionMenuTextColor">@color/black</item>
    </style>


    <plurals name="quick_seek_x_second">
        <item quantity="other">%d seconds</item>
        <item quantity="one">%d second</item>
        <item quantity="many">%d seconds</item>
    </plurals>

    <style name="SlidingDialogAnimation">
        <item name="android:windowEnterAnimation">@android:anim/slide_in_left</item>
        <item name="android:windowExitAnimation">@android:anim/slide_out_right</item>
    </style>

    <style name="ExoStyledControls.Button.Center.Secondary" parent="ExoStyledControls.Button.Center">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="ExoStyledControls.Button.Bottom">
        <item name="android:gravity">center_horizontal</item>
        <item name="android:layout_width">@dimen/exo_small_icon_width</item>
        <item name="android:layout_height">@dimen/exo_small_icon_height</item>
        <item name="android:layout_marginLeft">@dimen/exo_small_icon_horizontal_margin</item>
        <item name="android:layout_marginRight">@dimen/exo_small_icon_horizontal_margin</item>
        <item name="android:paddingLeft">@dimen/exo_small_icon_padding_horizontal</item>
        <item name="android:paddingRight">@dimen/exo_small_icon_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/exo_small_icon_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/exo_small_icon_padding_vertical</item>
    </style>

    <style name="BottomNavigationViewStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:fontFamily">@font/poppins_light</item>
        <item name="android:background">@color/transparent</item>
        <item name="android:textSize">11sp</item>
    </style>


    <style name="AppBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog" />

    <style name="AppModalStyle" parent="Widget.Design.BottomSheet.Modal" />

    <style name="SplashScreenTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowSoftInputMode">adjustPan</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="colorControlActivated">@color/brand_accent</item>
        <!--        <item name="backgroundColor">@color/white</item>-->
        <!--        <item name="android:windowIsTranslucent">true</item>-->
        <!--        <item name="android:windowContentOverlay">@null</item>-->
        <!--        <item name="android:windowNoTitle">true</item>-->
        <!--        <item name="android:windowIsFloating">true</item>-->
        <!--        <item name="android:backgroundDimEnabled">false</item>-->
        <!--        <item name="android:windowBackground">@drawable/splash_bg</item>-->
    </style>


    <style name="ViewPlayerTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
<!--        <item name="selectedColor">@color/dark_mode_green</item>-->
<!--        <item name="nonSelectedColor">@color/nonSelectedColor</item>-->
        <item name="colorAccent">@color/brand_accent</item>
        <item name="android:textColor">@color/brand_text_primary</item>
<!--        <item name="textIconColor">@color/black</item>-->
<!--        <item name="adButtonColor">@color/white</item>-->
<!--        <item name="folderColor">#47FFFFFF</item>-->

        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogTheme</item>
        <!-- Add the following item to specify the popup menu style -->
        <item name="popupMenuStyle">@style/PopupMenuStyle.Dark</item>

        <!--        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>-->
                <item name="android:windowTranslucentStatus">true</item>
                <item name="android:windowTranslucentNavigation">true</item>

        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:ignore="NewApi">shortEdges</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>

    </style>

    <!-- App dialogue theme. -->
    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>


    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerSize">10%</item>
    </style>

    <style name="PopupMenuStyle.Dark" parent="Widget.AppCompat.PopupMenu">
        <!-- Add this item to enable icons in the popup menu -->
        <item name="android:popupBackground">@color/primary_bg</item>
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="actionMenuTextColor">@color/brand_text_primary</item>
    </style>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogTheme</item>
    </style>


    <style name="AppBottomSheetDialogThemes" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalStylee</item>
    </style>

    <style name="AppModalStylee" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bottom_sheet_background</item>
    </style>


    <style name="SearchAutoCompleteTextView" parent="Widget.AppCompat.Light.AutoCompleteTextView">
        <item name="android:textColor">@color/theme_background_white</item>
        <item name="android:textColorHint">@color/nonSelectedColor</item>
    </style>

    <style name="StyleSearchView" parent="Widget.AppCompat.SearchView">
        <item name="colorControlActivated">@color/black</item>
        <item name="background">@android:color/transparent</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:queryHint">@string/query_hint_main</item>
        <item name="android:textColor">@color/gSelector</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>


    <!--  &lt;!&ndash; App dialogue theme. &ndash;&gt;
      <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
          <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
      </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>-->

    <string name="query_hint_main">enter</string>

    <!--- Nevigation Bar Selection -->
    <style name="NavigationView" parent="Theme.MaterialComponents">
        <item name="itemTextAppearanceActive">@style/ActiveText</item>
        <item name="itemTextAppearanceInactive">@style/ActiveText</item>
    </style>

    <style name="ActiveText">
        <item name="android:textSize">11sp</item>
        <item name="fontFamily">@font/poppins_light</item>
    </style>

    <style name="CustomCastExpandedController" parent="CastExpandedController">

        <item name="castControlButtons">
            @array/cast_expanded_controller_control_buttons
        </item>

    </style>

    <style name="NoUnderlineAutoCompleteTextView" parent="Widget.AppCompat.AutoCompleteTextView">
        <item name="android:background">@null</item>
        <item name="fontFamily">@font/poppins_regular</item>
    </style>

    <style name="tabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="textAllCaps">false</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>

    <style name="customTabLayout" parent="Widget.Design.TabLayout">
        <item name="tabIndicatorColor">@color/brand_accent</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabPaddingStart">12dp</item>
        <item name="tabPaddingEnd">12dp</item>
        <item name="textAllCaps">false</item>
        <item name="android:dividerPadding">3dp</item>
        <item name="android:divider">@android:color/black</item>
        <item name="tabBackground">?attr/selectableItemBackground</item>
        <item name="tabSelectedTextColor">@color/brand_accent</item>
        <item name="tabTextColor">@color/brand_text_secondary</item>
    </style>
</resources>