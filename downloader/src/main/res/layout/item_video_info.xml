<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View"/>

        <variable
            name="videoInfo"
            type="com.avd.data.local.room.entity.VideoInfo" />

        <variable
            name="dialogListener"
            type="com.avd.ui.component.dialog.DownloadTabListener" />

        <variable
            name="viewModel"
            type="com.avd.ui.main.home.browser.detectedVideos.DetectedVideosTabViewModel" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/primary_bg"
        android:background="@drawable/bottom_sheet_white"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5sdp"
            android:backgroundTint="@color/card_bg"
            android:background="@drawable/background_download_bottomsheet"
            android:padding="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl"
                android:layout_width="@dimen/_65sdp"
                android:layout_height="@dimen/_40sdp"
                android:backgroundTint="#6A6969"
                android:background="@drawable/round_bg_download"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.avd.ui.main.home.CustomImageView
                    android:id="@+id/thumbnail"
                    android:layout_width="@dimen/_65sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:src="@drawable/ic_vid_thumb"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginRight="@dimen/_5sdp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_medium"
                android:maxLines="1"
                android:text="Title of video"
                android:textColor="@color/brand_text_primary"
                android:textSize="@dimen/_10ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cl"
                app:layout_constraintTop_toTopOf="@id/cl"
                tools:ignore="RtlSymmetry" />

            <TextView
                android:id="@+id/tv_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:textColor="#A1A5A3"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@id/title"
                app:layout_constraintTop_toBottomOf="@id/title" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <EditText
            android:id="@+id/video_title_edit"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:hint="@string/video_title_edit"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxWidth="488dp"
            android:padding="@dimen/padding_small"
            android:visibility="gone" />

        <Button
            android:id="@+id/video_title_rename_button"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:text="@string/video_menu_rename"
            android:textColor="@color/brand_text_primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/urlTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLength="200"
            android:text="@{viewModel.selectedFormatUrl}"
            android:visibility="gone" />

        <TextView
            android:id="@+id/typeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sizeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/poppins_regular"
            android:textStyle="bold"
            android:text="@string/select_quality"
            android:textSize="@dimen/_12ssp"
            android:textColor="@color/gSelector_light" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/candidatesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/download_candidate_item" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_watch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_52sdp"
            android:layout_marginTop="10dp"
            android:onClick="@{() -> dialogListener.onPreviewVideo(videoInfo, viewModel.selectedFormats.get(videoInfo.id), false)}"
            android:visibility="@{videoInfo.tikTokVideo ? View.GONE : View.VISIBLE}"
            android:background="@drawable/bg_roundedview_"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:paddingStart="11dp"
            android:paddingTop="11dp"
            android:paddingEnd="11dp"
            android:paddingBottom="11dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingEnd="11dp"
                app:tint="@color/brand_text_primary"
                android:src="@drawable/ic_watch_online"
                app:layout_constraintBottom_toBottomOf="@id/tv_preview"
                app:layout_constraintEnd_toStartOf="@id/tv_preview"
                app:layout_constraintTop_toTopOf="@id/tv_preview"
                />

            <TextView
                android:id="@+id/tv_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/watch_online"
                android:textColor="@color/brand_text_primary"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_download"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_52sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/padding_large"
            android:background="@drawable/round_bg_download"
            android:backgroundTint="@color/gSelector_light"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:onClick="@{() -> dialogListener.onDownloadVideo(videoInfo, viewModel.selectedFormats.get(videoInfo.id), viewModel.formatsTitles.get(videoInfo.id))}"
            android:paddingStart="11dp"
            android:paddingTop="11dp"
            android:paddingEnd="11dp"
            android:paddingBottom="11dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingEnd="11dp"
                android:src="@drawable/ic_download_file"
                app:layout_constraintBottom_toBottomOf="@id/download"
                app:layout_constraintEnd_toStartOf="@id/download"
                app:layout_constraintTop_toTopOf="@id/download"
                app:tint="@color/brand_text_primary" />

            <TextView
                android:id="@+id/download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/dialog_download_video"
                android:textColor="@color/brand_text_primary"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</layout>
