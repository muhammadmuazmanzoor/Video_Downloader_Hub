<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="15dp"
    >

    <ImageView
        android:id="@+id/radio_unit"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/uncheck_new"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/radio_unit"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tv_size"
        android:text="Movie name"
        android:maxLines="2"
        android:layout_marginStart="15dp"
        android:textSize="15sp"
        android:textColor="@color/brand_text_primary"/>

    <TextView
        android:id="@+id/tv_size"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/radio_unit"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="5dp"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="107kb"
        android:maxLines="2"
        android:layout_marginStart="15dp"
        android:textSize="12sp"
        android:textColor="@color/grey01"/>

</androidx.constraintlayout.widget.ConstraintLayout>