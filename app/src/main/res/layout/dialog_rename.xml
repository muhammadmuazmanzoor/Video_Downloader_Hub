<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:paddingTop="5dp"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
        >

        <ImageView
            android:visibility="gone"
            android:id="@+id/ic_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_back_white"
            android:padding="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_subtitle_rename"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rename"
            android:layout_margin="20dp"
            android:textColor="@color/brand_text_primary"
            android:textSize="@dimen/_15ssp"
            android:fontFamily="@font/poppins_semibold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <EditText
            android:id="@+id/edsearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edittext"
            android:fontFamily="@font/poppins_regular"
            android:hint="@string/enter_a_new_file_name"
            android:textColor="@color/brand_text_primary"
            android:textColorHint="@color/gray_text"
            android:textColorHighlight="@color/gSelector_light"
            android:textSize="@dimen/_12ssp"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="@+id/view3"
            app:layout_constraintStart_toStartOf="@id/tv_subtitle_rename"
            app:layout_constraintTop_toTopOf="@+id/view3"
            app:layout_constraintWidth_percent="0.93" />

        <TextView
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:padding="12dp"
            android:text="@string/ok"
            android:paddingEnd="@dimen/_20ssp"
            android:textColor="@color/gSelector_light"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_cancel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btn_cancel" />

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp"
            android:fontFamily="@font/poppins_regular"
            android:padding="12dp"
            android:text="@string/cancel"
            android:textColor="@color/nonSelectedColor"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintEnd_toStartOf="@id/btn_search"
            app:layout_constraintTop_toBottomOf="@+id/view3" />


        <View
            android:id="@+id/view3"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_subtitle_rename" />

    </androidx.constraintlayout.widget.ConstraintLayout>