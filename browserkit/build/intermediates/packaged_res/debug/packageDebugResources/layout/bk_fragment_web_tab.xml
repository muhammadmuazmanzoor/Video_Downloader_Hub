<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bk_bg"
    android:orientation="vertical">

    <!-- Top chrome: back + URL pill -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBackNav"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/bk_back"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/bk_ic_chevron_left"
            app:tint="@color/bk_text_primary" />

        <LinearLayout
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bk_bg_url_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp">

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:ellipsize="end"
                android:hint="@string/bk_address_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/bk_text_primary"
                android:textColorHint="@color/bk_text_secondary"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnClearUrl"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bk_clear_url"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/bk_ic_close"
                android:visibility="gone"
                app:tint="@color/bk_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- WebView fills remaining space -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/pageProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:indeterminate="false"
            android:max="100"
            android:progressTint="@color/bk_primary"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/fabDownload"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/bk_bg_download_fab"
            android:clickable="true"
            android:contentDescription="@string/bk_download"
            android:elevation="12dp"
            android:focusable="false">

            <ImageView
                android:id="@+id/fabDownloadIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/bk_ic_download"
                app:tint="@color/bk_on_primary" />

            <ProgressBar
                android:id="@+id/fabDownloadLoading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/bk_on_primary"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <!-- Bottom chrome: back / forward / home / tabs / menu -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bk_tab_footer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnWebBack"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/bk_back"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/bk_ic_nav_back"
            app:tint="@color/bk_chrome_disabled" />

        <ImageButton
            android:id="@+id/btnWebForward"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/bk_forward"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/bk_ic_nav_forward"
            app:tint="@color/bk_chrome_disabled" />

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/bk_home"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/bk_ic_home_filled"
            app:tint="@color/bk_chrome_active" />

        <ImageButton
            android:id="@+id/btnTabs"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/bk_tabs"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/bk_ic_tabs_stack"
            app:tint="@color/bk_chrome_icon" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/bk_menu"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/bk_ic_more_horiz"
            app:tint="@color/bk_chrome_icon" />
    </LinearLayout>
</LinearLayout>
