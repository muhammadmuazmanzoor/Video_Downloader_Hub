<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app1="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_10sdp"
        android:paddingHorizontal="@dimen/_16sdp">

        <ImageView
            android:id="@+id/iv_video_option"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app1:tint="@color/brand_text_primary"
            android:src="@drawable/ic_playlist" />

        <TextView
            android:id="@+id/tv_video_option"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Share"
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/brand_text_primary"
            android:layout_marginStart="@dimen/_16sdp"
            android:fontFamily="@font/poppins_regular"
            app:layout_constraintStart_toEndOf="@id/iv_video_option"
            app:layout_constraintTop_toTopOf="@id/iv_video_option"
            app:layout_constraintBottom_toBottomOf="@id/iv_video_option" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>