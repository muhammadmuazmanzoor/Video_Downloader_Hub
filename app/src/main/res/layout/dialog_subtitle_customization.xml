<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/black"
    android:background="@drawable/bg_roundedview"
    android:paddingVertical="@dimen/_10sdp">

    <TextView
        android:id="@+id/iv_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_16sdp"
        android:fontFamily="@font/poppins_semibold"
        android:padding="@dimen/_4sdp"
        android:visibility="visible"
        android:textSize="13sp"
        android:textColor="@color/gSelector_light"
        android:text="@string/done"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/customization"
        android:textColor="@color/brand_text_primary"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <View
        android:id="@+id/viewa"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="#525252"
        app:layout_constraintTop_toBottomOf="@id/tv_unit" />

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@id/viewa">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp">
            <TextView
                android:id="@+id/sample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/_80sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:text="Sample Subtitle"
                android:paddingVertical="@dimen/_5sdp"
                android:textAlignment="center"
                android:textSize="@dimen/_13ssp"
                android:gravity="center"
                android:textColor="@color/dark_mode_green"
                android:background="@drawable/bg_roundedsubtitle"
                android:backgroundTint="#232323"/>
            <TextView
                android:id="@+id/tv_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/color"
                android:textColor="@color/brand_text_primary"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="@id/tv_layout"
                app:layout_constraintTop_toBottomOf="@id/sample" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/tv_color"
                app:layout_constraintStart_toEndOf="@id/tv_layout"
                tools:listitem="@layout/item_color"
                android:layout_marginTop="@dimen/_4sdp"/>
            <TextView
                android:id="@+id/tv_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/sizee"
                android:textColor="@color/brand_text_primary"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="@id/tv_layout"
                app:layout_constraintTop_toBottomOf="@id/recycler_view" />


            <TextView
                android:id="@+id/tv_min_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/poppins_regular"
                android:text="10"
                android:textColor="@color/brand_text_primary"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_size" />

            <SeekBar
                android:id="@+id/size_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:max="60"
                android:min="5"
                android:progressBackgroundTint="@color/white"
                android:progressTint="@color/dark_mode_green"
                android:thumbTint="@color/gSelector_light"
                app:layout_constraintEnd_toStartOf="@id/tv_max_size"
                app:layout_constraintStart_toEndOf="@id/tv_min_size"
                app:layout_constraintTop_toTopOf="@id/tv_min_size" />

            <TextView
                android:id="@+id/tv_max_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/poppins_regular"
                android:text="50"
                android:textColor="@color/brand_text_primary"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_size" />
            <TextView
                android:id="@+id/tv_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/position"
                android:textColor="@color/brand_text_primary"
                android:layout_marginTop="@dimen/_7sdp"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_max_size" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPosition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3"
                tools:itemCount="3"
                app:layout_constraintStart_toStartOf="@id/tv_layout"
                app:layout_constraintTop_toBottomOf="@id/tv_layout"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/item_position_selection"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>