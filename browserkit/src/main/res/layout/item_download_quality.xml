<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">

    <LinearLayout
        android:id="@+id/qualityCardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bk_bg_quality_card"
        android:gravity="center_horizontal"
        android:minHeight="120dp"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="16dp"
        android:elevation="2dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvQualityResolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bk_quality_resolution"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="1080p" />

        <TextView
            android:id="@+id/tvQualitySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/black"
            android:textSize="12sp"
            tools:text="Full HD" />

        <TextView
            android:id="@+id/tvQualitySize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bk_bg_quality_size_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/bk_text_secondary"
            android:textSize="11sp"
            tools:text="~2.4 GB" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivQualitySelected"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/bk_ic_quality_check"
        android:visibility="gone"
        tools:visibility="visible" />
</FrameLayout>
