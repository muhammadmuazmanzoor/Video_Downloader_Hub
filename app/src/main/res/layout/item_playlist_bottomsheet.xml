<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_5sdp"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app1="http://schemas.android.com/apk/res-auto">

        <View
            android:id="@+id/view_add"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:background="@drawable/bg_rounded_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"/>

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:src="@drawable/ic_heart_fil"
            app:layout_constraintStart_toStartOf="@id/view_add"
            app:layout_constraintEnd_toEndOf="@id/view_add"
            app:layout_constraintTop_toTopOf="@id/view_add"
            app:layout_constraintBottom_toBottomOf="@id/view_add"
            app:tint="@color/gSelector" />

        <TextView
            android:id="@+id/tv_playlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/view_add"
            app:layout_constraintTop_toTopOf="@id/view_add"
            android:layout_marginTop="@dimen/_3sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:text="@string/favourite"
            android:fontFamily="@font/poppins_regular"
            android:textSize="@dimen/_12sdp"
            android:textColor="@color/brand_text_primary"/>

        <TextView
            android:id="@+id/tv_videos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/view_add"
            app:layout_constraintTop_toBottomOf="@id/tv_playlist"
            app:layout_constraintBottom_toBottomOf="@id/view_add"
            android:layout_marginStart="@dimen/_10sdp"
            tools:text="2 Videos"
            android:fontFamily="@font/poppins_regular"
            android:textSize="@dimen/_10sdp"
            android:textColor="@color/nonSelectedColor"/>


    </androidx.constraintlayout.widget.ConstraintLayout>