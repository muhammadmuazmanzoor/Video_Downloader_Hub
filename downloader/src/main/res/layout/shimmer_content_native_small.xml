<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg_stroke"
    android:paddingBottom="@dimen/_8sdp"
    android:paddingEnd="@dimen/_3sdp">

    <View
        android:id="@+id/shimmer_media"
        android:layout_width="120dp"
        android:layout_height="130dp"
        android:layout_margin="@dimen/_5sdp"
        android:background="@drawable/round_corner_native_stroke"
        android:backgroundTint="@color/shimmer_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/shimmer_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/_5sdp"
        android:background="@drawable/round_corner_ad"
        android:backgroundTint="@color/shimmer_placeholder"
        app:layout_constraintStart_toEndOf="@id/shimmer_media"
        app:layout_constraintTop_toTopOf="@id/shimmer_media" />

    <View
        android:id="@+id/shimmer_ad_label"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_12sdp"
        android:layout_marginStart="@dimen/_7sdp"
        android:background="@drawable/round_corner_ad"
        android:backgroundTint="@color/shimmer_placeholder_accent"
        app:layout_constraintBottom_toBottomOf="@id/shimmer_icon"
        app:layout_constraintStart_toEndOf="@id/shimmer_icon"
        app:layout_constraintTop_toTopOf="@id/shimmer_icon" />

    <View
        android:id="@+id/shimmer_title"
        android:layout_width="0dp"
        android:layout_height="@dimen/_12sdp"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="@drawable/round_corner_ad"
        android:backgroundTint="@color/shimmer_placeholder"
        app:layout_constraintBottom_toBottomOf="@id/shimmer_ad_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/shimmer_ad_label"
        app:layout_constraintTop_toTopOf="@id/shimmer_ad_label" />

    <View
        android:id="@+id/shimmer_body"
        android:layout_width="0dp"
        android:layout_height="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="@drawable/round_corner_ad"
        android:backgroundTint="@color/shimmer_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/shimmer_icon"
        app:layout_constraintTop_toBottomOf="@id/shimmer_icon" />

    <View
        android:id="@+id/shimmer_cta"
        android:layout_width="0dp"
        android:layout_height="43dp"
        android:layout_marginHorizontal="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/round_corner_ad"
        android:backgroundTint="@color/shimmer_placeholder_accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/shimmer_media"
        app:layout_constraintTop_toBottomOf="@id/shimmer_body" />

</androidx.constraintlayout.widget.ConstraintLayout>
