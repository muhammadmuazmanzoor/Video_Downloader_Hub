<?xml version="1.0" encoding="utf-8"?>

<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight"> <!-- or your custom ripple color -->

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#F78145" /> <!-- Mask solid color, any opaque color -->
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#F78145" /> <!-- Your original background color -->
        </shape>
    </item>
</ripple>
