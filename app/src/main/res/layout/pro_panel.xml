<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <ImageView
            android:id="@+id/topimg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/pro_guy2"
            app:layout_constraintBottom_toTopOf="@id/guide1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/blurryView"
            android:layout_width="0dp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginTop="-32dp"
            android:scaleType="fitXY"
            android:src="@drawable/pro_blurr"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topimg" />


        <TextView
            android:id="@+id/tvHeadLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-12dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Start Like A Pro"
            android:textColor="@color/pro_dark_color"
            android:textSize="@dimen/_23ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/blurryView" />


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/pro_details"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvHeadLine"
            app:layout_constraintBottom_toTopOf="@+id/guide2"
            app:srcCompat="@drawable/pro_detail" />

        <TextView
            android:id="@+id/userGuidanceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="Loading..."
            android:textColor="@color/black"
            android:textSize="17sp"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pro_details" />

        <TextView
            android:id="@+id/tvTrailInfos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/black"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/dialog_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>


        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/dialog_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_80sdp"
            app:lottie_loop="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/guide3"
            />

        <TextView
            android:id="@+id/billing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:text="Recurring billing cancel anytime"
            android:textColor="#A6A6A6"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialog_button"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_bottom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_18sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/term"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_5sdp"
                android:text="Term of Use"
                android:textColor="#A6A6A6"
                android:textSize="@dimen/_11ssp"
                app:layout_constraintBottom_toBottomOf="@id/privacy"
                app:layout_constraintEnd_toStartOf="@+id/centerview"
                app:layout_constraintHeight_percent="0.05"
                app:layout_constraintStart_toStartOf="parent" />

            <View
                android:id="@+id/centerview"
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:background="@color/non_selected_play"
                app:layout_constraintBottom_toBottomOf="@+id/privacy"
                app:layout_constraintEnd_toStartOf="@id/privacy"
                app:layout_constraintStart_toEndOf="@id/term"
                app:layout_constraintTop_toTopOf="@+id/privacy" />

            <TextView
                android:id="@+id/privacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_5sdp"
                android:text="Privacy Policy"
                android:textColor="#A6A6A6"
                android:textSize="@dimen/_11ssp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/centerview2"
                app:layout_constraintStart_toEndOf="@id/centerview" />


            <TextView
                android:id="@+id/restore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_5sdp"
                android:text="Restore"
                android:textColor="#A6A6A6"
                android:textSize="@dimen/_11ssp"
                app:layout_constraintBottom_toBottomOf="@id/privacy"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.05"
                app:layout_constraintStart_toEndOf="@id/centerview2" />


            <View
                android:id="@+id/centerview2"
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:background="@color/non_selected_play"
                app:layout_constraintBottom_toBottomOf="@+id/privacy"
                app:layout_constraintEnd_toStartOf="@id/restore"
                app:layout_constraintStart_toEndOf="@id/privacy"
                app:layout_constraintTop_toTopOf="@+id/privacy" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <ImageView
            android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_18sdp"
            android:layout_marginEnd="@dimen/_13sdp"
            android:padding="@dimen/_7sdp"
            android:visibility="gone"
            android:src="@drawable/pro1_close"
            app:layout_constraintEnd_toEndOf="@+id/topimg"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.35" />


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.75" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.78" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>