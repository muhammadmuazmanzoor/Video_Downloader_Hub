                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dramaLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5sdp"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/socialLayout">

                    <TextView
                        android:id="@+id/textViewDrama"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Watch Dramas"
                        android:textSize="@dimen/_12ssp"
                        android:textColor="@color/brand_text_primary"
                        android:fontFamily="@font/poppins_medium"
                        android:paddingHorizontal="@dimen/_6sdp"
                        android:paddingTop="@dimen/_6sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/ArrowDrama"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_6sdp"
                        android:visibility="gone"
                        android:src="@drawable/tt_report_ad_arrow"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewDrama"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
