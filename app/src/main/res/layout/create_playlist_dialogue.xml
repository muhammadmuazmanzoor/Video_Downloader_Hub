<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/card_bg"
    android:background="@drawable/alert_dialog_rectangle">


    <TextView
        android:id="@+id/dialog_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create_your_playlist"
        android:textSize="18sp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/brand_text_primary"
        android:layout_marginTop="@dimen/_20sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <EditText
        android:id="@+id/playlist_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:textColor="@color/brand_text_primary"
        android:textSize="14sp"
        android:textColorHint="@color/gray_text"
        android:layout_margin="@dimen/_30sdp"
        android:focusable="true"
        android:background="@null"
        android:importantForAutofill="noExcludeDescendants"
        app:layout_constraintTop_toBottomOf="@+id/dialog_heading"
        app:layout_constraintStart_toStartOf="@+id/dialog_heading"
        app:layout_constraintEnd_toEndOf="@+id/dialog_heading"/>

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="@id/playlist_name"
        app:layout_constraintEnd_toEndOf="@id/playlist_name"
        app:layout_constraintTop_toBottomOf="@id/playlist_name"
        android:background="@color/gSelector"/>


    <TextView
        android:id="@+id/btn_cancels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:padding="@dimen/_10sdp"
        android:text="@string/cancel"
        android:fontFamily="@font/poppins_medium"
        android:textSize="16sp"
        android:textColor="@color/nonSelectedColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_oks"
        app:layout_constraintTop_toBottomOf="@+id/playlist_name" />

    <TextView
        android:id="@+id/btn_oks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ok"
        android:fontFamily="@font/poppins_medium"
        android:textSize="16sp"
        android:padding="@dimen/_10sdp"
        android:textColor="@color/gSelector_light"
        app:layout_constraintEnd_toEndOf="@+id/playlist_name"
        app:layout_constraintTop_toTopOf="@+id/btn_cancels" />

</androidx.constraintlayout.widget.ConstraintLayout>