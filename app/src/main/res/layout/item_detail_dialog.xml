<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:circularflow_radiusInDP="16dp"
    android:background="@color/primary_bg"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:text="@string/property"
        android:textColor="@color/gSelector_light"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="24dp"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/poppins_regular"
        android:text="@string/name"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/brand_text_primary"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="@string/name"
        android:fontFamily="@font/poppins_regular"
        android:textSize="12sp"
        android:layout_marginEnd="24dp"
        android:maxLines="2"
        android:ems="2"
        android:textColor="@color/brand_text_primary"
        app:layout_constraintBottom_toBottomOf="@+id/name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/name" />

    <TextView
        android:id="@+id/path"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/poppins_regular"
        android:text="@string/path"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/brand_text_primary"
        app:layout_constraintStart_toStartOf="@+id/name"
        app:layout_constraintTop_toBottomOf="@+id/name" />

    <TextView
        android:id="@+id/tvPath"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="@string/path"
        android:textSize="12sp"
        android:fontFamily="@font/poppins_regular"
        android:layout_marginEnd="24dp"
        android:maxLines="2"
        android:ems="2"
        android:textColor="@color/brand_text_primary"
        app:layout_constraintBottom_toBottomOf="@+id/path"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/path" />

    <TextView
        android:id="@+id/size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/poppins_regular"
        android:text="@string/size"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/brand_text_primary"
        app:layout_constraintStart_toStartOf="@+id/path"
        app:layout_constraintTop_toBottomOf="@+id/path" />

    <TextView
        android:id="@+id/tvSize"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="@string/size"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/poppins_regular"
        android:textSize="12sp"
        android:textColor="@color/brand_text_primary"
        app:layout_constraintBottom_toBottomOf="@+id/size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/size" />

    <TextView
        android:id="@+id/resolution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/poppins_regular"
        android:text="@string/resolution"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/brand_text_primary"
        app:layout_constraintStart_toStartOf="@+id/size"
        app:layout_constraintTop_toBottomOf="@+id/size" />

    <TextView
        android:id="@+id/tvResolution"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="@string/resolution"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/poppins_regular"
        android:textSize="12sp"
        android:textColor="@color/brand_text_primary"
        app:layout_constraintBottom_toBottomOf="@+id/resolution"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/resolution" />


    <Button
        android:id="@+id/btnOk"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ok"
        android:textColor="@color/gSelector_light"
        android:fontFamily="@font/poppins_regular"
        android:textFontWeight="700"
        android:textSize="16sp"
        android:layout_marginVertical="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tvResolution"
        app:layout_constraintTop_toBottomOf="@id/tvResolution" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="168dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
