<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg_stroke"
    android:paddingBottom="@dimen/_10sdp">

    <View
        android:id="@+id/shimmer_ad_label"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_14sdp"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/round_corner_ad"
        android:backgroundTint="@color/shimmer_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/shimmer_title"
        android:layout_width="0dp"
        android:layout_height="@dimen/_14sdp"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_20sdp"
        android:background="@drawable/round_corner_ad"
        android:backgroundTint="@color/shimmer_placeholder"
        app:layout_constraintBottom_toBottomOf="@id/shimmer_ad_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/shimmer_ad_label"
        app:layout_constraintTop_toTopOf="@id/shimmer_ad_label" />

    <View
        android:id="@+id/shimmer_media"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/round_corner_ad"
        android:backgroundTint="@color/shimmer_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/shimmer_ad_label" />

    <View
        android:id="@+id/shimmer_cta"
        android:layout_width="0dp"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginHorizontal="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@drawable/gradient_bg"
        android:backgroundTint="@color/shimmer_placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/shimmer_media" />

</androidx.constraintlayout.widget.ConstraintLayout>
