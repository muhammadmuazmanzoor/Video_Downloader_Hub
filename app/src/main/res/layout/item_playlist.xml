<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_9sdp"
        android:paddingVertical="@dimen/_3sdp"
        android:layout_marginTop="@dimen/_10sdp">
        <ImageView
            android:id="@+id/updown"
            android:layout_width="22dp"
            android:layout_height="30dp"
            android:layout_margin="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@drawable/movingupdown_svg"
            android:backgroundTint="@color/darkgrey"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_playlist_thumbnail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginVertical="8dp"
            app:cardCornerRadius="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/updown">

            <ImageView
                android:id="@+id/iv_playlist_thumbnail"
                android:layout_width="@dimen/_65sdp"
                android:layout_height="@dimen/_60sdp"
                android:background="@drawable/bg_playlist_thumbnail"
                android:src="@drawable/ic_video"
                android:scaleType="centerCrop"
                />

        </androidx.cardview.widget.CardView>



        <TextView
            android:id="@+id/tv_video_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/cv_playlist_thumbnail"
            app:layout_constraintBottom_toBottomOf="@id/cv_playlist_thumbnail"
            android:text="00:88"
            android:textColor="@color/brand_text_primary"
            android:textSize="10sp"
            android:elevation="5dp"
            android:background="@drawable/bg_textview"
            android:fontFamily="@font/montserrat_regular"/>

        <TextView
            android:id="@+id/tv_song_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/cv_playlist_thumbnail"
            app:layout_constraintEnd_toStartOf="@+id/remove_item"
            app:layout_constraintTop_toTopOf="@id/cv_playlist_thumbnail"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:text="Lorem ipsum dolor sit amit constectur"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_regular"/>

        <TextView
            android:visibility="gone"
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/cv_playlist_thumbnail"
            app:layout_constraintTop_toBottomOf="@id/tv_song_title"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:text="2023-25-06"
            android:textColor="@color/disableColor"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_regular"/>

        <View
            android:visibility="gone"
            android:id="@+id/view"
            android:layout_width="@dimen/_1sdp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/tv_date"
            app:layout_constraintTop_toTopOf="@id/tv_date"
            app:layout_constraintBottom_toBottomOf="@id/tv_date"
            android:layout_marginStart="@dimen/_5sdp"
            android:background="@color/disableColor"/>

        <TextView
            android:visibility="visible"
            android:id="@+id/tv_song_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/tv_song_title"
            app:layout_constraintTop_toTopOf="@id/tv_date"
            app:layout_constraintBottom_toBottomOf="@id/tv_date"
            android:text="1.95 MB"
            android:textColor="@color/disableColor"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_regular"/>

        <ImageView
            android:id="@+id/remove_item"
            android:layout_width="20dp"
            android:layout_height="19dp"
            android:layout_margin="8dp"
            android:padding="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/remove_item_svg"
            android:backgroundTint="@color/darkgrey"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>