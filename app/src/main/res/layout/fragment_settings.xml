<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/lib/my_package_name"
    tools:context=".ui.fragments.SettingsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        ads:layout_constraintEnd_toEndOf="parent"
        android:background="@color/transparency"
        ads:layout_constraintStart_toStartOf="parent"
        ads:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/menuIcon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/_14sdp"
            ads:layout_constraintBottom_toBottomOf="parent"
            ads:layout_constraintStart_toStartOf="parent"
            ads:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/ic_back"
            ads:tint="@color/black"/>

        <TextView
            android:id="@+id/appBarTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_16sdp"
            android:text="Settings"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold"
            ads:layout_constraintBottom_toBottomOf="parent"
            ads:layout_constraintStart_toEndOf="@+id/menuIcon"
            ads:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/divider_bottom"
            android:layout_width="match_parent"
            android:layout_height="0.9dp"
            android:background="#1A000000"
            ads:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/themes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:padding="@dimen/_8sdp"
        android:src="@drawable/theme_icon"
        ads:layout_constraintStart_toStartOf="parent"
        ads:layout_constraintTop_toBottomOf="@+id/appbar"
        ads:tint="@color/black" />

    <TextView
        android:id="@+id/themeText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:text="Themes"
        android:textColor="@color/black"
        android:padding="@dimen/_6sdp"
        android:textSize="16sp"
        android:textStyle="normal"
        ads:layout_constraintBottom_toBottomOf="@+id/themes"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toEndOf="@+id/themes"
        ads:layout_constraintTop_toTopOf="@+id/themes" />


    <View
        android:id="@+id/themeview"
        android:layout_width="0dp"
        android:layout_height="0.99dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="#1A000000"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toStartOf="@+id/shareText"
        ads:layout_constraintTop_toBottomOf="@+id/imageView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:padding="@dimen/_8sdp"
        android:src="@drawable/noun_share"
        ads:layout_constraintStart_toStartOf="parent"
        ads:layout_constraintTop_toBottomOf="@+id/themes"
        ads:tint="@color/black" />

    <TextView
        android:id="@+id/shareText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:text="Share"
        android:textColor="@color/black"
        android:padding="@dimen/_6sdp"
        android:textSize="16sp"
        android:textStyle="normal"
        ads:layout_constraintBottom_toBottomOf="@+id/imageView2"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toEndOf="@+id/imageView2"
        ads:layout_constraintTop_toTopOf="@+id/imageView2" />


    <View
        android:id="@+id/divider1"
        android:layout_width="0dp"
        android:layout_height="0.99dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="#1A000000"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toStartOf="@+id/shareText"
        ads:layout_constraintTop_toBottomOf="@+id/imageView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_5sdp"
        android:padding="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:src="@drawable/noun_feedback"
        ads:tint="@color/black"
        ads:layout_constraintStart_toStartOf="parent"
        ads:layout_constraintTop_toBottomOf="@+id/imageView2" />

    <TextView
        android:id="@+id/rateUsText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:text="Rate Us"
        android:textSize="16sp"
        android:padding="@dimen/_6sdp"
        android:textStyle="normal"
        android:textColor="@color/black"
        ads:layout_constraintBottom_toBottomOf="@+id/imageView3"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toEndOf="@+id/imageView3"
        ads:layout_constraintTop_toTopOf="@+id/imageView3" />


    <View
        android:id="@+id/divider2"
        android:layout_width="0dp"
        android:layout_height="0.99dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="#1A000000"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toStartOf="@+id/rateUsText"
        ads:layout_constraintTop_toBottomOf="@+id/imageView3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_5sdp"
        android:padding="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:src="@drawable/noun_privacy"
        ads:tint="@color/black"
        ads:layout_constraintStart_toStartOf="parent"
        ads:layout_constraintTop_toBottomOf="@+id/imageView3" />

    <TextView
        android:id="@+id/privacyPolicyText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:text="Privacy Policy"
        android:textSize="16sp"
        android:padding="@dimen/_6sdp"
        android:textStyle="normal"
        android:textColor="@color/black"
        ads:layout_constraintBottom_toBottomOf="@+id/imageView4"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toEndOf="@+id/imageView4"
        ads:layout_constraintTop_toTopOf="@+id/imageView4" />


    <View
        android:id="@+id/divider3"
        android:layout_width="0dp"
        android:layout_height="0.99dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="#1A000000"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toStartOf="@+id/privacyPolicyText"
        ads:layout_constraintTop_toBottomOf="@+id/imageView4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <RelativeLayout
        android:id="@+id/top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_1sdp"
        android:paddingVertical="@dimen/_1sdp"
        android:padding="@dimen/_3sdp"
        ads:layout_constraintBottom_toBottomOf="parent"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/fl_adplace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:maxHeight="280dp"
            android:background="@drawable/native_ad_border"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/ourgraphic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:scaleType="centerInside"
            android:src="@drawable/exit_image" />
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>