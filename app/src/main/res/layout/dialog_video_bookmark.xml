<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bookmark_dialog">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="@dimen/_30sdp"
            android:padding="5dp"
            android:src="@drawable/ic_back_white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/bookmark"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:ellipsize="end"
            android:maxLines="1"
            android:padding="8dp"
            android:textColor="@color/brand_text_primary"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/btn_back"
            app:layout_constraintStart_toEndOf="@+id/btn_back"
            app:layout_constraintTop_toTopOf="@+id/btn_back" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_video_bookmark"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintBottom_toTopOf="@id/cl_bottom"
            android:layout_marginTop="@dimen/_10sdp"
            tools:listitem="@layout/item_video_bookmark"
            android:layout_marginStart="@dimen/_10sdp"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_bottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_100sdp"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="@dimen/_44sdp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/exo_progress"
                app:layout_constraintBottom_toBottomOf="@id/exo_progress"
                android:text="02:14:02"
               android:layout_marginStart="@dimen/_5sdp"
                android:textColor="@color/brand_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.video.avd.utils.CustomTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="55dp"
                app:played_color="@color/gSelector"
                app:scrubber_drawable="@drawable/player_thumb_drawable"
                app:layout_constraintStart_toEndOf="@id/exo_position"
                app:layout_constraintEnd_toStartOf="@id/exo_duration"
                app:layout_constraintBottom_toTopOf="@id/exo_play_pause"
                app:unplayed_color="#4B4B4B" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                app:layout_constraintEnd_toEndOf="@id/cl_button"
                app:layout_constraintTop_toTopOf="@id/exo_progress"
                app:layout_constraintBottom_toBottomOf="@id/exo_progress"
                android:text="05:00"
                android:layout_marginStart="@dimen/_5sdp"
                android:textColor="@color/brand_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/bg_rounded_bookmark"
                app:layout_constraintBottom_toBottomOf="@id/exo_play_pause"
                app:layout_constraintTop_toTopOf="@id/exo_play_pause"
                android:layout_marginEnd="@dimen/_10sdp"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingVertical="@dimen/_3sdp"
                >

                <ImageView
                    android:id="@+id/plus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:src="@drawable/ic_plus_bookmark"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@+id/plus"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:text="@string/add"
                    android:textColor="@color/brand_text_primary"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginStart="@dimen/_5sdp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageButton
                android:id="@id/exo_play_pause"
                style="@style/ExoMediaButton.Pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/white"
                android:src="@drawable/ic_bookmark_dg_play"
                android:tintMode="src_in"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                app:tint="@color/brand_text_primary" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>