<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.main.settings.SettingFragmentNew"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/brand_background"
    android:layout_marginBottom="10dp"
    android:focusableInTouchMode="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/wa_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginVertical="24dp"
            android:layout_marginStart="16dp"
            android:padding="10dp"
            app:tint="@color/brand_text_primary"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/settings"
            android:textColor="@color/brand_text_primary"
            android:textSize="17sp"
            app:layout_constraintBottom_toBottomOf="@+id/wa_back"
            app:layout_constraintStart_toEndOf="@+id/wa_back"
            app:layout_constraintTop_toTopOf="@+id/wa_back" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_premimum"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_margin="15dp"
        android:background="@drawable/ic_premium_background"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionbar">

        <ImageView
            android:id="@+id/imgpre"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_premium_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/upgrade_to_premium"
            android:textColor="@color/brand_text_primary"
            app:layout_constraintStart_toEndOf="@+id/imgpre"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/remove_all_ads"
            android:textColor="@color/brand_text_primary"
            app:layout_constraintStart_toStartOf="@+id/textView2"
            app:layout_constraintTop_toBottomOf="@+id/textView2" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_15sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_next_navigate" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_how_download"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_margin="15dp"
        android:background="@drawable/round_corner"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionbar">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgque"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_question"
            app:tint="@color/brand_text_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/how_to_use"
            android:textColor="@color/brand_text_primary"
            app:layout_constraintBottom_toBottomOf="@+id/imgque"
            app:layout_constraintStart_toEndOf="@+id/imgque"
            app:layout_constraintTop_toTopOf="@+id/imgque" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:text="@string/download"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_3sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:textColor="@color/bottom_nav_selected"
        app:layout_constraintStart_toStartOf="@+id/cl_how_download"
        app:layout_constraintTop_toBottomOf="@+id/cl_how_download" />
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/label"
        app:layout_constraintBottom_toBottomOf="@+id/label"
        app:layout_constraintStart_toStartOf="@+id/label"
        app:layout_constraintEnd_toEndOf="@+id/label"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/downloadsetting1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/round_corner"
        android:layout_margin="15dp"
        app:layout_constraintTop_toBottomOf="@+id/label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/downloadicon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_16sdp"
            app:tint="@color/brand_text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_download_setting" />

        <TextView
            android:id="@+id/labeldownloadlocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:layout_margin="@dimen/_10sdp"
            android:textSize="@dimen/_12sdp"
            android:text="@string/download_location"
            android:textColor="@color/brand_text_primary"
            app:layout_constraintStart_toEndOf="@+id/downloadicon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvdownloadlocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="/storage/emulated/0/download"
            android:textColor="#8A8380"
            android:textSize="@dimen/_8sdp"
            app:layout_constraintStart_toStartOf="@+id/labeldownloadlocation"
            app:layout_constraintTop_toBottomOf="@+id/labeldownloadlocation" />

        <View
            android:id="@+id/view1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#5F5F5F"
            android:layout_marginTop="@dimen/_7sdp"
            app:layout_constraintTop_toBottomOf="@+id/tvdownloadlocation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/wifiicon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_16sdp"
            app:tint="@color/brand_text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view1"
            app:srcCompat="@drawable/ic_wifi" />

        <TextView
            android:id="@+id/labelwifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/download_with_wi_fi_only"
            android:textColor="@color/brand_text_primary"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="@+id/wifiicon"
            app:layout_constraintStart_toEndOf="@+id/wifiicon"
            app:layout_constraintTop_toTopOf="@+id/wifiicon" />

        <ToggleButton
            android:id="@+id/toggleButton1"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_18sdp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/_10sdp"
            android:background="@drawable/toogel_selector"
            android:checked="false"
            android:text=""
            android:textOff=""
            android:textOn=""
            android:textColor="@color/brand_text_primary"
            app:layout_constraintBottom_toBottomOf="@+id/labelwifi"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/labelwifi" />

        <View
            android:id="@+id/view2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#5F5F5F"
            android:layout_marginTop="@dimen/_7sdp"
            app:layout_constraintTop_toBottomOf="@+id/labelwifi"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/langicon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_16sdp"
            app:tint="@color/brand_text_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view2"
            app:srcCompat="@drawable/ic_lang_setting" />

        <TextView
            android:id="@+id/labellang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/change_language"
            android:textColor="@color/brand_text_primary"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="@+id/langicon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/langicon"
            app:layout_constraintTop_toTopOf="@+id/langicon" />

        <TextView
            android:id="@+id/tv_lang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            app:layout_constraintBottom_toBottomOf="@+id/labellang"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/labellang" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/langGroup"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="langicon,labellang"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/labellang"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view2"
            app:layout_constraintVertical_bias="0.0" />


    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/fl_adplace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:maxHeight="290dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_margin="@dimen/_12sdp"
        android:visibility="visible"
        android:layout_marginTop="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/downloadsetting1">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:paddingVertical="@dimen/_5sdp"
            app:shimmer_auto_start="true"
            app:shimmer_duration="1500">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <View
                    android:id="@+id/shimmer_media"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/round_corner_ad"
                    android:backgroundTint="#DDDDDD"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    app:layout_constraintTop_toBottomOf="@+id/shimmer_ad_label"
                    app:layout_constraintBottom_toTopOf="@+id/shimmer_cta"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <View
                    android:id="@+id/shimmer_ad_label"
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:background="@drawable/round_corner_ad"
                    android:backgroundTint="#DDDDDD"
                    app:layout_constraintBottom_toTopOf="@+id/shimmer_media"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/shimmer_title"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="@dimen/_20sdp"
                    android:background="@drawable/round_corner_ad"
                    android:backgroundTint="#DDDDDD"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/shimmer_ad_label"
                    app:layout_constraintTop_toTopOf="@id/shimmer_ad_label" />

                <View
                    android:id="@+id/shimmer_cta"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_33sdp"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_marginVertical="@dimen/_5sdp"
                    android:background="@drawable/round_corner_ad"
                    android:backgroundTint="#DDDDDD"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:background="@drawable/round_corner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_adplace">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/shareicon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_16sdp"
            app:tint="@color/brand_text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_share_new_setting" />

        <TextView
            android:id="@+id/labelshare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/share_app"
            android:textColor="@color/brand_text_primary"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="@+id/shareicon"
            app:layout_constraintEnd_toStartOf="@+id/sharenext"
            app:layout_constraintStart_toEndOf="@+id/shareicon"
            app:layout_constraintTop_toTopOf="@+id/shareicon" />


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/sharenext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="20dp"
            app:tint="@color/brand_text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_next_move" />


        <androidx.constraintlayout.widget.Group
            android:id="@+id/shareGroup"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:constraint_referenced_ids="shareicon,labelshare,sharenext"
            app:layout_constraintBottom_toBottomOf="@+id/labelshare"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/labelshare" />


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/rateicon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_16sdp"
            app:tint="@color/brand_text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shareicon"
            app:srcCompat="@drawable/ic_rate" />

        <TextView
            android:id="@+id/labelrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/rate_us"
            android:textColor="@color/brand_text_primary"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="@+id/rateicon"
            app:layout_constraintStart_toEndOf="@+id/rateicon"
            app:layout_constraintTop_toTopOf="@+id/rateicon" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ratenext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="20dp"
            app:tint="@color/brand_text_primary"
            app:layout_constraintBottom_toBottomOf="@+id/labelrate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/labelrate"
            app:srcCompat="@drawable/ic_next_move" />


        <androidx.constraintlayout.widget.Group
            android:id="@+id/rateGroup"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:constraint_referenced_ids="rateicon,labelrate,ratenext"
            app:layout_constraintBottom_toBottomOf="@+id/labelrate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/labelrate" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/privacyicon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_16sdp"
            app:tint="@color/brand_text_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rateicon"
            app:srcCompat="@drawable/ic_privacy" />

        <TextView
            android:id="@+id/labelprivacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/privacy_policy"
            android:textColor="@color/brand_text_primary"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="@+id/privacyicon"
            app:layout_constraintStart_toEndOf="@+id/privacyicon"
            app:layout_constraintTop_toTopOf="@+id/privacyicon" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/privacynext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_16sdp"
            app:tint="@color/brand_text_primary"
            app:layout_constraintBottom_toBottomOf="@+id/labelprivacy"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/labelprivacy"
            app:srcCompat="@drawable/ic_next_move" />


        <androidx.constraintlayout.widget.Group
            android:id="@+id/privacyGroup"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:constraint_referenced_ids="privacyicon,labelprivacy,privacynext"
            app:layout_constraintBottom_toBottomOf="@+id/labelprivacy"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/labelprivacy" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>