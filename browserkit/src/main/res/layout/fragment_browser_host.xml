<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bk_on_primary">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/tabPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Full-screen tabs switcher -->
    <LinearLayout
        android:id="@+id/tabsSwitcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bk_on_primary"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btnTabsBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bk_back"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/bk_ic_chevron_left"
                app:tint="@color/black" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bk_bg_url_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvTabsAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/bk_text_primary"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnTabsClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/bk_close_tabs"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/bk_ic_close"
                    app:tint="@color/bk_on_primary" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTabs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="88dp" />

            <ImageButton
                android:id="@+id/fabNewTab"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bk_bg_fab_accent"
                android:contentDescription="@string/bk_new_tab"
                android:elevation="6dp"
                android:padding="16dp"
                android:scaleType="centerInside"
                android:src="@drawable/bk_ic_add" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/bk_on_primary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageButton
                android:id="@+id/btnTabsWebBack"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bk_back"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/bk_ic_nav_back"
                app:tint="@color/black" />

            <ImageButton
                android:id="@+id/btnTabsWebForward"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bk_forward"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/bk_ic_nav_forward"
                app:tint="@color/black" />

            <ImageButton
                android:id="@+id/btnTabsHome"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bk_home"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/bk_ic_home_outline"
                app:tint="@color/black" />

            <ImageButton
                android:id="@+id/btnTabsSwitcher"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bk_tabs"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/bk_ic_tabs_stack"
                app:tint="@color/black" />

            <ImageButton
                android:id="@+id/btnTabsMenu"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bk_menu"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/bk_ic_more_horiz"
                app:tint="@color/black" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
