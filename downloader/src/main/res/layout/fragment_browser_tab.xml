<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.main.home.browser.homeTab.BrowserTabFragment">

    <data>
        <import type="android.view.View" />
        <import type="com.avd.data.local.model.Suggestion" />
        <variable
            name="browserMenuListener"
            type="com.avd.ui.main.home.browser.BrowserListener" />
        <variable
            name="viewModel"
            type="com.avd.ui.main.home.browser.homeTab.BrowserHomeViewModel" />
        <variable
            name="mainVModel"
            type="com.avd.ui.main.home.MainViewModel" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/brand_background"
                android:paddingBottom="@dimen/_45sdp"
                >

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/actionbar"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.06"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Browser"
                        android:textColor="@color/brand_text_primary"
                        android:textSize="17sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_pro_new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:padding="5dp"
                        android:src="@drawable/premium_svg"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@+id/tab_count"
                        app:layout_constraintEnd_toStartOf="@+id/tab_count"
                        app:layout_constraintTop_toTopOf="@+id/tab_count" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/tab_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="7dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_tab_icon"
                        android:visibility="visible"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/img_menu"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/brand_text_primary" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/cl_setting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_setting_new"
                        android:tint="@color/black"
                        android:visibility="visible"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tab_count"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/black" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/img_menu"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_marginEnd="5dp"
                        android:onClick="@{() -> browserMenuListener.onBrowserMenuClicked()}"
                        android:paddingHorizontal="5dp"
                        android:src="@drawable/ic_download_menu"
                        android:visibility="visible"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/black" />


                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintLayout3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:paddingBottom="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/actionbar">



                    <View
                        android:id="@+id/view2"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_browser_search_pill"
                        android:clickable="false"
                        android:focusable="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <ProgressBar
                        android:id="@+id/video_progress_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/bottom_nav_selected"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="@+id/view2"
                        app:layout_constraintStart_toStartOf="@+id/view2"
                        app:layout_constraintTop_toBottomOf="@+id/view2"
            android:progressTint="@color/bottom_nav_selected" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/search_engine"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintBottom_toBottomOf="@+id/view2"
                        app:layout_constraintStart_toStartOf="@+id/view2"
                        app:layout_constraintTop_toTopOf="@+id/view2"
                        app:srcCompat="@drawable/ic_link" />

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/home_et_search"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="8dp"
                        android:background="@android:color/transparent"
                        android:elevation="0dp"
                        android:hint="Search video term"
                        android:onClick="@{() -> viewModel.logClick()}"
                        android:paddingStart="@dimen/_30sdp"
                        android:paddingEnd="0dp"
                        android:singleLine="true"
                        android:textColor="@color/brand_text_primary"
                        android:textColorHint="#8A8A8A"
                        android:textColorHighlight="#332286F7"
                        android:textCursorDrawable="@drawable/search_text_cursor_blue"
                        android:textSelectHandle="@drawable/search_text_select_handle_blue"
                        android:textSelectHandleLeft="@drawable/search_text_select_handle_blue"
                        android:textSelectHandleRight="@drawable/search_text_select_handle_blue"
                        android:textSize="@dimen/text_small"
                        app:items="@{viewModel.suggestionItems}"
                        app:layout_constraintBottom_toBottomOf="@+id/view2"
                        app:layout_constraintEnd_toEndOf="@+id/view2"
                        app:layout_constraintStart_toEndOf="@+id/search_engine"
                        app:layout_constraintTop_toTopOf="@id/view2"
                        tools:ignore="RtlSymmetry" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ic_search"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="16dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/search"
                        android:padding="0dp"
                        android:tint="#F5A000"
                        app:layout_constraintBottom_toBottomOf="@+id/view2"
                        app:layout_constraintEnd_toEndOf="@+id/view2"
                        app:layout_constraintTop_toTopOf="@+id/view2"
                        app:srcCompat="@drawable/search_24px" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/socialLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/constraintLayout3">

                    <TextView
                        android:id="@+id/textViewSocial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:paddingHorizontal="@dimen/_6sdp"
                        android:paddingTop="@dimen/_6sdp"
                        android:text="Social"
                        android:textColor="@color/brand_text_primary"
                        android:textSize="@dimen/_12ssp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewSocial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textViewSocial"
                        tools:itemCount="4"
                        tools:listitem="@layout/social_item_browser" />

                </androidx.constraintlayout.widget.ConstraintLayout>
                <!-- Watch Dramas flow commented out. Hidden placeholder keeps constraints and view binding stable. -->
